<mxGraphModel adaptiveColors="none" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;Dataset, episode kind, seed&lt;/b&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#1E3A8A;strokeColor=#1E3A8A;fontColor=#FFFFFF;fontSize=13;strokeWidth=1.5;fontFamily=Helvetica;arcSize=50;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="220" height="46" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Draw contiguous block&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#475569'&gt;both classes &amp;ge; 5% of rows&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#0F172A;fontSize=13;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="112" width="220" height="62" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Reference: 2000 rows&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#475569'&gt;fit f on 1500, importance on 500&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;fontColor=#0F172A;fontSize=13;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="204" width="220" height="62" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Pool: next 20,000 rows&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#475569'&gt;same period, no built-in drift&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;fontColor=#0F172A;fontSize=13;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="296" width="220" height="62" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Draw onset s in [10, 16]&lt;/b&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#0F172A;fontSize=13;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="388" width="220" height="62" as="geometry"/></mxCell><mxCell id="c6" value="Episode kind?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;fontColor=#0F172A;fontSize=13;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="466" width="180" height="90" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Clean&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#475569'&gt;uniform sampling&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#0F172A;fontSize=13;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="310" y="592" width="220" height="62" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Gradual / abrupt shift&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#475569'&gt;feature j from important or&lt;br&gt;unimportant half; weights &amp;prop; exp(&amp;lambda;(t) &amp;sigma; z&lt;sub&gt;j&lt;/sub&gt;)&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;fontColor=#0F172A;fontSize=13;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="310" y="480" width="220" height="76" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Label change&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#475569'&gt;flip labels, p &amp;rarr; 0.3, if z&lt;sub&gt;k&lt;/sub&gt; &amp;gt; 0&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;fontColor=#0F172A;fontSize=13;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="310" y="704" width="220" height="62" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Sample 45 batches&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#475569'&gt;300 rows each, with replacement&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#0F172A;fontSize=13;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="590" y="480" width="220" height="62" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;True accuracy of f&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#475569'&gt;per batch, from the kept labels&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#0F172A;fontSize=13;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="590" y="592" width="220" height="62" as="geometry"/></mxCell><mxCell id="c12" value="Event after onset?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;fontColor=#0F172A;fontSize=13;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="610" y="694" width="180" height="90" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Harmful episode&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#475569'&gt;event at or after onset&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;fontColor=#0F172A;fontSize=13;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="590" y="858" width="220" height="62" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Harmless episode&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#475569'&gt;no event&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#0F172A;fontSize=13;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="310" y="800" width="220" height="62" as="geometry"/></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=12;fontFamily=Helvetica;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=12;fontFamily=Helvetica;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=12;fontFamily=Helvetica;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=12;fontFamily=Helvetica;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=12;fontFamily=Helvetica;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=12;fontFamily=Helvetica;" edge="1" parent="1" source="c8" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=12;fontFamily=Helvetica;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=12;fontFamily=Helvetica;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" value="clean" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=12;fontFamily=Helvetica;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" value="shift" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=12;fontFamily=Helvetica;" edge="1" parent="1" source="c6" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c25" value="label change" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=12;fontFamily=Helvetica;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c6" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=12;fontFamily=Helvetica;exitX=1;exitY=0.5;entryX=0;entryY=0.75;" edge="1" parent="1" source="c7" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=12;fontFamily=Helvetica;exitX=1;exitY=0.5;entryX=0;entryY=1;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c28" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=12;fontFamily=Helvetica;fontColor=#DC2626;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c29" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=12;fontFamily=Helvetica;fontColor=#059669;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="c12" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c30" value="&lt;font style='font-size:11px;color:#475569'&gt;Spurious episodes (event before onset) are excluded.&lt;br&gt;Per dataset: 10 clean, 30 gradual,&lt;br&gt;15 abrupt and 10 label-change episodes.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#0F172A;fontFamily=Helvetica;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="776" width="230" height="90" as="geometry"/></mxCell></root></mxGraphModel>