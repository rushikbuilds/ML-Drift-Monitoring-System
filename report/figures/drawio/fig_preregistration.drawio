<mxGraphModel adaptiveColors="none" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;New idea after a verdict&lt;/b&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#1E3A8A;strokeColor=#1E3A8A;fontColor=#FFFFFF;fontSize=13;strokeWidth=1.5;fontFamily=Helvetica;arcSize=50;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="210" height="50" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Write protocol&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#475569'&gt;hypotheses, pass rules, datasets&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#0F172A;fontSize=13;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="125" width="210" height="64" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Commit config module&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#475569'&gt;timestamped in git&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#0F172A;fontSize=13;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="210" height="64" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Develop on development data&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#475569'&gt;choose thresholds and rules&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#0F172A;fontSize=13;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="335" width="210" height="64" as="geometry"/></mxCell><mxCell id="c5" value="Development gate passed?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;fontColor=#0F172A;fontSize=13;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="55" y="430" width="180" height="90" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Stop, report negative&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#475569'&gt;no fresh data used (v9)&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;fontColor=#0F172A;fontSize=13;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="210" height="64" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Freeze thresholds&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#475569'&gt;SHA-256 fingerprint in protocol&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#0F172A;fontSize=13;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="330" y="20" width="210" height="64" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Download confirmation data&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#475569'&gt;datasets never used before&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;fontColor=#0F172A;fontSize=13;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="330" y="125" width="210" height="64" as="geometry"/></mxCell><mxCell id="c9" value="Fingerprint matches?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;fontColor=#0F172A;fontSize=13;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="345" y="220" width="180" height="90" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Refuse to run&lt;/b&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;fontColor=#0F172A;fontSize=13;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="620" y="230" width="210" height="64" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;One-time confirmation run&lt;/b&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#0F172A;fontSize=13;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="330" y="335" width="210" height="64" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Verdict script&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#475569'&gt;applies the frozen pass rules&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#0F172A;fontSize=13;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="330" y="440" width="210" height="64" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Publish verdict&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#475569'&gt;success, partial success or failure&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#0F172A;fontSize=13;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="330" y="560" width="210" height="64" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Deviation log&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#475569'&gt;every change dated, with its reason,&lt;br&gt;recorded before any affected&lt;br&gt;episode is built&lt;/font&gt;" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;fontColor=#0F172A;fontSize=13;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="620" y="430" width="210" height="100" as="geometry"/></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=12;fontFamily=Helvetica;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=12;fontFamily=Helvetica;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geome